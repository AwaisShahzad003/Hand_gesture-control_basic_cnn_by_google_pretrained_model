import cv2
import numpy as np
import pyautogui
import mediapipe as mp
from mediapipe.tasks import python
from mediapipe.tasks.python import vision
import math
import os
import webbrowser
import time 

# 1. Setup paths and MediaPipe
script_dir = os.path.dirname(os.path.abspath(__file__))
model_path = os.path.join(script_dir, "hand_landmarker.task") #

screen_w, screen_h = pyautogui.size() #
cap = cv2.VideoCapture(0)

# Lower resolution for better performance on limited hardware
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

CONNECTIONS = [
    (0, 1), (1, 2), (2, 3), (3, 4), (0, 5), (5, 6), (6, 7), (7, 8),
    (0, 9), (9, 10), (10, 11), (11, 12), (0, 13), (13, 14), (14, 15), (15, 16),
    (0, 17), (17, 18), (18, 19), (19, 20), (5, 9), (9, 13), (13, 17)
]

# Control Variables
frame_red = 100 
smoothing = 10 # Higher smoothing for stability on low-performance GPUs
prev_x, prev_y = 0, 0
is_active = True 

# --- UPDATED DELAY LOGIC ---
last_action_time = 0
action_cooldown = 5.0 # Set to 5 seconds as requested

options = vision.HandLandmarkerOptions(
    base_options=python.BaseOptions(model_asset_path=model_path), #
    running_mode=vision.RunningMode.IMAGE, #
    num_hands=1,
    min_hand_detection_confidence=0.7 
)
detector = vision.HandLandmarker.create_from_options(options)

while is_active:
    ret, frame = cap.read()
    if not ret: break
    frame = cv2.flip(frame, 1) #
    h, w, _ = frame.shape

    rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB) #
    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb_frame) #
    result = detector.detect(mp_image) #

    current_time = time.time() #

    if result.hand_landmarks:
        hand_landmarks = result.hand_landmarks[0] #
        
        # --- DRAWING ---
        for conn in CONNECTIONS:
            p1 = (int(hand_landmarks[conn[0]].x * w), int(hand_landmarks[conn[0]].y * h))
            p2 = (int(hand_landmarks[conn[1]].x * w), int(hand_landmarks[conn[1]].y * h))
            cv2.line(frame, p1, p2, (0, 0, 255), 2)
        for lm in hand_landmarks:
            cv2.circle(frame, (int(lm.x * w), int(lm.y * h)), 5, (0, 255, 0), cv2.FILLED)

        # Distance helper
        def get_dist(p1_idx, p2_idx):
            p1 = hand_landmarks[p1_idx]
            p2 = hand_landmarks[p2_idx]
            return math.hypot(p1.x - p2.x, p1.y - p2.y)

        # Finger states
        index_up = get_dist(8, 0) > 0.25
        middle_up = get_dist(12, 0) > 0.25
        ring_up = get_dist(16, 0) > 0.25
        pinky_up = get_dist(20, 0) > 0.25

        # --- GESTURE ACTION COOLDOWN ---
        if current_time - last_action_time > action_cooldown:
            
            # 1. GESTURE: FIST + FIRST FINGER -> OPEN GMAIL
            if index_up and not middle_up and not ring_up and not pinky_up:
                cv2.putText(frame, "GMAIL DETECTED", (50, 50), cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 255, 0), 2)
                webbrowser.open('https://mail.google.com')
                last_action_time = current_time

            # 2. GESTURE: FULL PALM -> OPEN YOUTUBE
            elif index_up and middle_up and ring_up and pinky_up:
                cv2.putText(frame, "YOUTUBE DETECTED", (50, 50), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)
                webbrowser.open('https://www.youtube.com')
                last_action_time = current_time

            # 3. GESTURE: FIST -> CLOSE WINDOW
            elif not index_up and not middle_up and not ring_up and not pinky_up:
                cv2.putText(frame, "CLOSE DETECTED", (50, 50), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)
                pyautogui.hotkey('alt', 'f4')
                last_action_time = current_time

        # --- MOUSE MOVEMENT (STAYS ACTIVE) ---
        if index_up:
            ix, iy = int(hand_landmarks[8].x * w), int(hand_landmarks[8].y * h)
            target_x = np.interp(ix, (frame_red, w - frame_red), (0, screen_w)) #
            target_y = np.interp(iy, (frame_red, h - frame_red), (0, screen_h)) #
            curr_x = prev_x + (target_x - prev_x) / smoothing #
            curr_y = prev_y + (target_y - prev_y) / smoothing #
            pyautogui.moveTo(curr_x, curr_y) #
            prev_x, prev_y = curr_x, curr_y

    # Visual countdown indicator
    if current_time - last_action_time < action_cooldown:
        remaining = int(action_cooldown - (current_time - last_action_time))
        cv2.putText(frame, f"Wait: {remaining}s", (w - 150, 50), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 165, 255), 2)

    cv2.imshow("Hand Control by Awais Shahzad", frame)
    if cv2.waitKey(1) & 0xFF == 27:
        is_active = False

cap.release()
cv2.destroyAllWindows()
